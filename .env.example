# 复制为 .env 后按需填写(.env 已在 .gitignore)。

# ── 数据库 ────────────────────────────────────────────────
# 本地开发指向本机 PG;compose 内由 docker-compose.yml 注入指向 postgres 服务。
DATABASE_URL=postgresql+psycopg2://localhost:5432/balloon_platform

# ── 对象存储(OSS 占位,本期不实现真实上传)【不变量三】────────
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── 打标复核阈值(留位,本期不跑打标)────────────────────────
REVIEW_CONFIDENCE_THRESHOLD=0.6
