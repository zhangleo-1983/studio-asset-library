{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tagging_output_v1",
  "description": "打标输出 JSON Schema 骨架:在 properties 中声明与 taxonomy.json 的 extraction[].path 对应的字段。",
  "type": "object",
  "required": [
    "image_id",
    "confidence",
    "needs_review",
    "notes"
  ],
  "properties": {
    "image_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_review": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}