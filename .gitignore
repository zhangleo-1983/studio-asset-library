# 本地工具配置,不入库
.claude/settings.local.json

# 系统
.DS_Store

# Python(评审通过、开始写代码后生效)
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
*.egg-info/
build/
dist/

# demo 素材(可由行业包的演示素材生成器重新生成(make demo-assets);正式合规图不入仓,演示机本地放置)
demo_assets/
# 内部 QA 目测产物永不入仓(红线:来源未核实的图片对外禁用)
internal_qa_*/

# 本地图库目录(内部质量目测集/来源不明素材所在处)——永不入仓,防误提交
图片识别/
local_images/
<LOCAL_IMAGE_DIR>/
# 位图默认不入仓:仓库不携带任何图片二进制。确需入库的图片(文档截图、logo、白名单素材),
# 用 `!路径` 在此显式放行,并同步登记 ASSETS.md(来源/许可)。
*.png
*.jpg
*.jpeg
*.webp
*.gif
# 例外:文档截图目录(只放程序绘制插画的演示截图,须在 ASSETS.md 登记)
!docs/images/
!docs/images/*
